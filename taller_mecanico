class AplicacionPrincipal(tk.Tk):
    def __init__(self, id_usuario, perfil_usuario, nombre_usuario):
        super().__init__()
        self.id_usuario = id_usuario
        self.perfil_usuario = perfil_usuario
        self.nombre_usuario = nombre_usuario
        
        self.title(f"Sistema Taller Automotriz | Perfil: {perfil_usuario} - {nombre_usuario}")
        self.geometry("700x650")
        self.configure(bg=COLOR_FONDO)
        
        # Aplicar un estilo moderno a los widgets ttk nativos
        style = ttk.Style()
        if "clam" in style.theme_names():
            style.theme_use("clam")
            
        self.contenedor = tk.Frame(self, bg=COLOR_FONDO)
        self.contenedor.pack(fill="both", expand=True)
        self.vista_actual = None
        self.crear_menu()
        
        # Pantalla de bienvenida
        pantalla_inicio = tk.Frame(self.contenedor, bg=COLOR_FONDO)
        pantalla_inicio.pack(expand=True)
        tk.Label(pantalla_inicio, text="🚗 Bienvenido al Sistema del Taller", bg=COLOR_FONDO, fg="#2c3e50", font=("Arial", 18, "bold")).pack(pady=20)
        tk.Label(pantalla_inicio, text="Seleccione un módulo en el menú superior para comenzar", bg=COLOR_FONDO, fg="#7f8c8d", font=("Arial", 12)).pack()

    def crear_menu(self):
        barra_menu = tk.Menu(self)
        self.config(menu=barra_menu)
        
        menu_modulos = tk.Menu(barra_menu, tearoff=0)
        barra_menu.add_cascade(label="Módulos del Sistema", menu=menu_modulos)

        if self.perfil_usuario == "Administrador":
            menu_modulos.add_command(label="👥 Gestión de Usuarios", command=lambda: self.mostrar_vista(VistaUsuarios))
            menu_modulos.add_command(label="👤 Gestión de Clientes", command=lambda: self.mostrar_vista(VistaClientes))
            menu_modulos.add_command(label="🚙 Gestión de Vehículos", command=lambda: self.mostrar_vista(VistaVehiculos))
        elif self.perfil_usuario == "Mecanico":
            menu_modulos.add_command(label="🚙 Gestión de Vehículos", command=lambda: self.mostrar_vista(VistaVehiculos))
        elif self.perfil_usuario == "Auxiliar":
            menu_modulos.add_command(label="👤 Gestión de Clientes", command=lambda: self.mostrar_vista(VistaClientes))
            menu_modulos.add_command(label="🚙 Gestión de Vehículos", command=lambda: self.mostrar_vista(VistaVehiculos))

        menu_modulos.add_separator()
        menu_modulos.add_command(label="Cerrar Sesión", command=self.cerrar_sesion)

    def mostrar_vista(self, clase_vista):
        if self.vista_actual:
            self.vista_actual.destroy()
        for widget in self.contenedor.winfo_children():
            widget.destroy()
        self.vista_actual = clase_vista(self.contenedor, self)
        self.vista_actual.pack(fill="both", expand=True)

    def cerrar_sesion(self):
        self.destroy()
        Login().mainloop()

class Login(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Acceso al Sistema")
        self.geometry("350x300")
        self.configure(bg="#2c3e50")
        self.resizable(False, False)

        # Panel blanco interno para dar efecto de "tarjeta"
        panel = tk.Frame(self, bg="white", padx=20, pady=20)
        panel.pack(expand=True, fill="both", padx=20, pady=20)

        tk.Label(panel, text="TALLER AUTOMOTRIZ", bg="white", fg="#2c3e50", font=("Arial", 14, "bold")).pack(pady=(0, 15))
        
        tk.Label(panel, text="Usuario:", bg="white", fg="#7f8c8d", font=("Arial", 10, "bold")).pack(anchor="w")
        self.txt_user = ttk.Entry(panel, width=30, font=("Arial", 11))
        self.txt_user.pack(pady=(0, 10), ipady=3)
        
        tk.Label(panel, text="Contraseña:", bg="white", fg="#7f8c8d", font=("Arial", 10, "bold")).pack(anchor="w")
        self.txt_pass = ttk.Entry(panel, width=30, show="*", font=("Arial", 11))
        self.txt_pass.pack(pady=(0, 15), ipady=3)
        
        tk.Button(panel, text="Ingresar", bg="#2980b9", fg="white", font=("Arial", 10, "bold"), relief="flat", cursor="hand2", command=self.verificar_login).pack(fill="x", pady=5, ipady=5)

    def verificar_login(self):
        user = self.txt_user.get()
        pwd = self.txt_pass.get()
        conexion = conectar_db()
        if conexion:
            cursor = conexion.cursor()
            cursor.execute("SELECT usuario_id, perfil, nombre FROM usuarios WHERE username = %s AND password = %s", (user, pwd))
            resultado = cursor.fetchone()
            conexion.close()
            if resultado:
                id_usuario, perfil, nombre = resultado
                self.destroy()
                app = AplicacionPrincipal(id_usuario, perfil, nombre)
                app.mainloop()
            else:
                messagebox.showerror("Acceso Denegado", "El usuario o la contraseña son incorrectos.")

if __name__ == "__main__":
    Login().mainloop()